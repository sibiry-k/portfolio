extends "base/base.pug"
block content
  .form-page
    .form-card
      h2.form-title Вход
      form(method="post")
        {{ form.csrf_token }}
        .form-group
          {{ form.username.label }}
          {{ form.username }}
        .form-group
          {{ form.password.label }}
          {{ form.password }}
        {{ form.submit }}
      .form-flash
        - with messages = get_flashed_messages()
          if messages
            for message in messages
              p= message