extends "base/base.pug"
block content
  .form-page
    .form-card
      h2.form-title Регистрация
      form(method="post")
        {{ form.csrf_token }}
        .form-group
          {{ form.username.label }}
          {{ form.username }}
        .form-group
          {{ form.email.label }}
          {{ form.email }}
        .form-group
          {{ form.password.label }}
          {{ form.password }}
        .form-group
          {{ form.password2.label }}
          {{ form.password2 }}
        .form-captcha
          div(
            style="height: 100px"
            id="captcha-container"
            class="smart-captcha"
            data-sitekey="{{ captcha_key }}"
            data-hl="ru"
          )
        .form-flash
          - with messages = get_flashed_messages()
            if messages
              for message in messages
                p= message
        {{ form.submit }}